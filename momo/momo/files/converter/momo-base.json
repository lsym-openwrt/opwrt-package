{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "fakeip",
        "tag": "fake-ip-dns-server",
        "inet4_range": "198.18.0.0/16",
        "inet6_range": "fc00::/18"
      },
      {
        "type": "udp",
        "tag": "dns_resolver",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "dns_remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "__PROXY__"
      }
    ],
    "rules": [
      {
        "action": "route",
        "domain_suffix": [
          "local",
          "lan",
          "arpa"
        ],
        "server": "dns_resolver"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns_resolver"
      },
      {
        "action": "route",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fake-ip-dns-server"
      }
    ],
    "final": "dns_remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "listen_port": 1053
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "0.0.0.0",
      "listen_port": 12345
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 12346
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "momo-tun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": false,
      "strict_route": false,
      "stack": "system"
    }
  ],
  "outbounds": [],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "inbound": [
          "dns-in"
        ],
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns_resolver",
      "strategy": "prefer_ipv4"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
